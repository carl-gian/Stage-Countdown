{
  "name": "stagecountdown",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "electron:dev": "vite build && electron .",
    "electron:start": "electron .",
    "build:win": "vite build && electron-builder --win nsis portable --x64 --publish never",
    "test": "vitest run",
    "release:win": "vite build && electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "com.stagecountdown.app",
    "productName": "StageCountdown",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "StageCountdown-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "carl-gian",
      "repo": "Project-Stage-Countdown",
      "releaseType": "release"
    },
    "portable": {
      "artifactName": "StageCountdown-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.5.4",
    "lucide-react": "^0.446.0",
    "obs-websocket-js": "^5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9",
    "ws": "^8.22.0"
  }
}
